# Operating-system, editor, and agent-local state
.DS_Store
Thumbs.db
.vscode/
.claude/
.agents/
.codex/

# Environment and machine-local configuration
.env
.env.*
!.env.example
include/config.php
include/webhook-config.php

# Frontend dependencies and local caches
frontend/user-portal/node_modules/
frontend/user-portal/.vite/
frontend/user-portal/dist/
npm-debug.log*
*.log

# Runtime uploads and customer data
assets/deposit/*
!assets/deposit/.gitkeep
assets/idcard/*
!assets/idcard/.gitkeep
assets/profile/*
!assets/profile/.gitkeep
assets/backups/


# Legacy data exports and backup archives
SQL File/database.sql
SQL File/database-*.sql
admin/admin.zip

# Local dev/verification helpers (Playwright screenshots, adhoc scripts)
/scripts/
frontend/user-portal/server.log*
*.log.txt

# Read-only mirror of the pre-Vue legacy repo for design-reference lookups.
# Never committed — every file inside is considered dead ballast unless
# consciously ported into the active tree.
/.legacy-reference/

# Retired pre-Vue customer pages. Kept on disk as the porting reference for
# the remaining Vue work, but untracked so they stop shipping to the server:
# .cpanel.yml rsyncs with --delete, so anything untracked is removed on deploy.
# Every /user/* URL already 301s to a Vue route via .htaccess, so nothing
# reachable depends on these files.
/user/
