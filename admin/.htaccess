 <IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ $1 [R,L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule (.*) $1.php [L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule (.*) $1.html [L]
 </IfModule>

<Files ~ "^\w+\.(gif|jpe?g|png)$">
order deny,allow
allow from all
</Files>


# `Header set Access-Control-Allow-Origin "*"` used to sit here, applied to the
# whole admin panel. It let any origin on the internet read the response body of
# every page under /admin — including customer PII and the CSRF token embedded
# in each form — from a logged-in operator's browser via fetch(). The panel
# serves no cross-origin API, so the header has no legitimate consumer.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
# php -- END cPanel-generated handler, do not edit
