# Block direct access to git metadata and deployment config. Defence in
# depth — rsync in .cpanel.yml already excludes .git/, but if someone
# ever clones the repo directly into public_html these blocks matter.
<FilesMatch "^\.(git|gitignore|env|htaccess)">
  Require all denied
</FilesMatch>
<IfModule mod_authz_core.c>
  <DirectoryMatch "^.*/\.git">
    Require all denied
  </DirectoryMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect retired customer entry files to their canonical Vue routes.
  # These rules preserve old bookmarks and links without keeping PHP wrapper files.
  RewriteRule ^(login|pin|reset-password|dashboard|transactions|wire-transfer|domestic-transfer|withdrawals|cards|loans|tickets)\.php$ /$1 [R=301,L,NE]
  RewriteRule ^(?:updatePassword|update-password)\.php$ /update-password [R=301,L,NE]
  RewriteRule ^(?:profile|profile-center)\.php$ /profile [R=301,L,NE]
  RewriteRule ^portal-page\.php$ /dashboard [R=301,L,NE]
  RewriteRule ^profile-center/?$ /profile [R=301,L,NE]
  RewriteRule ^p/forgot-password(?:\.php)?/?$ /reset-password [R=301,L,NE]

  # Legacy signup URLs redirect to the new Vue register wizard.
  RewriteRule ^signup(?:/.*)?$ /register [R=301,L,NE]
  RewriteRule ^user/card(?:\.php)?/?$ /cards [R=301,L,NE]
  RewriteRule ^user/(?:loan|loan-transaction|viewloantrans)(?:\.php)?/?$ /loans [R=301,L,NE]
  RewriteRule ^user/(?:profile|edit-profile)(?:\.php)?/?$ /profile [R=301,L,NE]
  RewriteRule ^user/wire-transfer(?:\.php)?/?$ /wire-transfer [R=301,L,NE]
  RewriteRule ^user/domestic-transfer(?:\.php)?/?$ /domestic-transfer [R=301,L,NE]
  RewriteRule ^user/(?:withdrawal|withdrawal-transaction|bank-withdraw)(?:\.php)?/?$ /withdrawals [R=301,L,NE]
  RewriteRule ^user/(?:credit-debit_transaction|wire-transaction|domestic-transaction)(?:\.php)?/?$ /transactions [R=301,L,NE]
  RewriteRule ^user/account-manager(?:\.php)?/?$ /tickets [R=301,L,NE]
  RewriteRule ^user/pin(?:\.php)?/?$ /transfer-verify [R=301,L,NE]
  RewriteRule ^user/cot(?:\.php)?/?$ /transfer-cot [R=301,L,NE]
  RewriteRule ^user/tax(?:\.php)?/?$ /transfer-tax [R=301,L,NE]
  RewriteRule ^user/imf-code(?:\.php)?/?$ /transfer-imf [R=301,L,NE]
  RewriteRule ^user(?:/.*)?$ /dashboard [R=301,L,NE]

  # Normalize trailing slashes for non-directories.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # Vue owns authentication and customer-facing routes through one PHP front controller.
  # Admin and public marketing routes continue to use their existing PHP entry points.
  RewriteRule ^(login|register|pin|reset-password|update-password|terms|privacy|dashboard|transactions|deposits|wire-transfer|domestic-transfer|withdrawals|cards|loans|tickets|profile|transfer-verify|transfer-cot|transfer-tax|transfer-imf|transfer-success)$ user-app.php [L,QSA]
  RewriteRule ^profile/(edit|security|manager)$ user-app.php [L,QSA]
  # Dynamic detail routes owned by the Vue SPA.
  RewriteRule ^transactions/(?:(?:transaction|deposit|wire|domestic|withdrawal)/)?[0-9]+$ user-app.php [L,QSA]

  # Preserve extensionless URLs for existing public PHP and HTML pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<Files ~ "^\w+\.(gif|jpe?g|png)$">
order deny,allow
allow from all
</Files>

# php -- END cPanel-generated handler, do not edit
